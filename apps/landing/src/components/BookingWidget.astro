---
/**
 * Calendly-style booking widget — plain TypeScript island, no framework.
 *
 * API contract (see packages/shared):
 *   GET  {API}/api/booking/days?month=YYYY-MM&tz={IANA} -> { days: ["YYYY-MM-DD", …] }
 *   GET  {API}/api/booking/slots?date=YYYY-MM-DD&tz={IANA} -> { slots: [{start,end}] }
 *   POST {API}/api/booking
 *        JSON { start, name, email, phone, practice_type, patient_flow, notes?, timezone }
 *        -> 201 { id, start, end, meetLink } | 409 { error: "slot_taken" } | 400
 */
import { PRACTICE_TYPES, PATIENT_FLOW_OPTIONS } from '@implenix/shared';

const apiUrl: string = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
---

<div class="bw" id="booking-widget" data-api-url={apiUrl}>
  <!-- Left: event info panel -->
  <aside class="bw__info">
    <p class="bw__brand">Implenix</p>
    <h2 class="bw__event">Intro Call — Billing Review</h2>
    <ul class="bw__meta">
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        30 min
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="m22 9-6 3 6 3z"/></svg>
        Google Meet — link arrives by email
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span data-bw="tz-note">Your local timezone</span>
      </li>
    </ul>
    <p class="bw__desc">
      A working session about your practice's billing — denials, AR, and where
      revenue is leaking. No obligation.
    </p>
  </aside>

  <!-- Right: calendar → times → form → success -->
  <div class="bw__main">
    <!-- Calendar + times -->
    <section class="bw__pick" data-bw="pick-view" aria-labelledby="bw-pick-heading">
      <h3 id="bw-pick-heading" class="bw__heading">Select a Date &amp; Time</h3>
      <div class="bw__pick-cols" data-bw="pick-cols">
        <div class="bw__calendar">
          <div class="bw__month-nav">
            <button type="button" class="bw__month-btn" data-bw="prev-month" aria-label="Previous month">‹</button>
            <span class="bw__month-label" data-bw="month-label" aria-live="polite"></span>
            <button type="button" class="bw__month-btn" data-bw="next-month" aria-label="Next month">›</button>
          </div>
          <div class="bw__weekdays" aria-hidden="true" data-bw="weekdays"></div>
          <div class="bw__days" data-bw="days" role="grid" aria-label="Choose a day"></div>
          <p class="bw__cal-status" data-bw="cal-status" hidden></p>
        </div>
        <div class="bw__times-col" data-bw="times-col" hidden>
          <p class="bw__times-day" data-bw="times-day"></p>
          <div class="bw__times-status" data-bw="time-status" hidden></div>
          <div class="bw__times" data-bw="times" role="group" aria-label="Available times"></div>
        </div>
      </div>
    </section>

    <!-- Details form -->
    <section class="bw__form-view" data-bw="form-view" hidden aria-labelledby="bw-form-heading">
      <button type="button" class="bw__back" data-bw="back" aria-label="Back to calendar">
        ‹ Back
      </button>
      <h3 id="bw-form-heading" class="bw__heading">Enter Details</h3>
      <p class="bw__chosen" data-bw="chosen-slot"></p>

      <form data-bw="form" novalidate>
        <div class="bw__grid">
          <div class="bw__field">
            <label for="bw-name">Full name <span aria-hidden="true">*</span></label>
            <input id="bw-name" name="name" type="text" autocomplete="name" required />
            <p class="bw__error" data-error-for="name" hidden>Please enter your name.</p>
          </div>
          <div class="bw__field">
            <label for="bw-email">Email <span aria-hidden="true">*</span></label>
            <input id="bw-email" name="email" type="email" autocomplete="email" required />
            <p class="bw__error" data-error-for="email" hidden>Please enter a valid email address.</p>
          </div>
          <div class="bw__field">
            <label for="bw-phone">Phone <span aria-hidden="true">*</span></label>
            <input id="bw-phone" name="phone" type="tel" autocomplete="tel" required />
            <p class="bw__error" data-error-for="phone" hidden>Please enter your phone number.</p>
          </div>
          <div class="bw__field">
            <label for="bw-practice-type">Practice type <span aria-hidden="true">*</span></label>
            <select id="bw-practice-type" name="practice_type" required>
              <option value="" selected disabled>Select your practice type…</option>
              {PRACTICE_TYPES.map((t) => <option value={t}>{t}</option>)}
            </select>
            <p class="bw__error" data-error-for="practice_type" hidden>Please select your practice type.</p>
          </div>
          <div class="bw__field">
            <label for="bw-patient-flow">Patient flow <span aria-hidden="true">*</span></label>
            <select id="bw-patient-flow" name="patient_flow" required>
              <option value="" selected disabled>How many patients per month?</option>
              {PATIENT_FLOW_OPTIONS.map((o) => <option value={o}>{o}</option>)}
            </select>
            <p class="bw__error" data-error-for="patient_flow" hidden>Please select your monthly patient flow.</p>
          </div>
          <div class="bw__field bw__field--full">
            <label for="bw-notes">Anything we should know?</label>
            <textarea
              id="bw-notes"
              name="notes"
              rows="3"
              placeholder="Current biller, EHR/PM system, biggest billing headache…"></textarea>
          </div>
        </div>

        <div class="bw__alert" data-bw="submit-alert" role="alert" hidden></div>

        <button type="submit" class="btn btn--primary btn--lg bw__submit" data-bw="submit">
          Schedule Event
        </button>
      </form>
    </section>

    <!-- Success -->
    <section class="bw__success" data-bw="success" hidden aria-labelledby="bw-success-heading">
      <span class="bw__success-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
      <h3>You're booked!</h3>
      <p class="bw__success-when" data-bw="success-when"></p>
      <p>A calendar invite with a Google Meet link is on its way to your inbox.</p>
    </section>
  </div>

  <noscript>
    <p class="bw__alert">
      The booking calendar needs JavaScript. If you can't enable it, email us at
      <a href="mailto:contact@implenix.net">contact@implenix.net</a> and we'll
      find a time together.
    </p>
  </noscript>
</div>

<script>
  interface Slot {
    start: string; // ISO UTC
    end: string; // ISO UTC
  }

  const root = document.getElementById('booking-widget');
  if (root instanceof HTMLElement) initBookingWidget(root);

  function initBookingWidget(root: HTMLElement): void {
    const apiUrl = (root.dataset.apiUrl ?? '').replace(/\/+$/, '');
    const timezone =
      Intl.DateTimeFormat().resolvedOptions().timeZone || 'America/New_York';

    const $ = <T extends HTMLElement = HTMLElement>(sel: string): T => {
      const el = root.querySelector<T>(`[data-bw="${sel}"]`);
      if (!el) throw new Error(`booking widget: missing element "${sel}"`);
      return el;
    };

    const tzNote = $('tz-note');
    const pickView = $('pick-view');
    const monthLabel = $('month-label');
    const prevBtn = $<HTMLButtonElement>('prev-month');
    const nextBtn = $<HTMLButtonElement>('next-month');
    const weekdaysEl = $('weekdays');
    const daysEl = $('days');
    const calStatus = $('cal-status');
    const timesCol = $('times-col');
    const timesDay = $('times-day');
    const timeStatus = $('time-status');
    const timesEl = $('times');
    const formView = $('form-view');
    const backBtn = $('back');
    const chosenSlotEl = $('chosen-slot');
    const form = $<HTMLFormElement>('form');
    const submitBtn = $<HTMLButtonElement>('submit');
    const submitAlert = $('submit-alert');
    const successEl = $('success');
    const successWhen = $('success-when');

    let viewYear = 0;
    let viewMonth = 0; // 0-based
    let selectedDate: string | null = null; // YYYY-MM-DD
    let selectedSlot: Slot | null = null;
    let fetchSeq = 0;
    const monthCache = new Map<string, string[] | 'error'>();

    tzNote.textContent = timezone.replace(/_/g, ' ');

    // -- formatting helpers -------------------------------------------------

    const monthFmt = new Intl.DateTimeFormat(undefined, { month: 'long', year: 'numeric' });
    const longDayFmt = new Intl.DateTimeFormat(undefined, {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
    });
    const fullFmt = new Intl.DateTimeFormat(undefined, {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    });
    const timeFmt = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const weekdayFmt = new Intl.DateTimeFormat(undefined, { weekday: 'short' });

    function pad(n: number): string {
      return String(n).padStart(2, '0');
    }

    function monthKey(y: number, m: number): string {
      return `${y}-${pad(m + 1)}`;
    }

    function dateFromKey(key: string): Date {
      const [y, m, d] = key.split('-').map(Number);
      return new Date(y, m - 1, d, 12); // noon avoids DST edge weirdness
    }

    function slotLabel(slot: Slot): string {
      const start = new Date(slot.start);
      return `${timeFmt.format(start)}, ${fullFmt.format(start)}`;
    }

    // -- analytics beacon ---------------------------------------------------

    function track(type: string): void {
      try {
        const payload = JSON.stringify({
          type,
          page: location.pathname,
          referrer: document.referrer || undefined,
        });
        const blob = new Blob([payload], { type: 'application/json' });
        if (!navigator.sendBeacon?.(`${apiUrl}/api/track`, blob)) {
          void fetch(`${apiUrl}/api/track`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload,
            keepalive: true,
          }).catch(() => {});
        }
      } catch {
        /* analytics must never break booking */
      }
    }

    let startedTracked = false;

    // -- month grid ---------------------------------------------------------

    // Sunday-first weekday header (matches Calendly).
    (() => {
      const base = new Date(2023, 0, 1); // a Sunday
      for (let i = 0; i < 7; i++) {
        const d = new Date(base.getFullYear(), base.getMonth(), base.getDate() + i);
        const cell = document.createElement('span');
        cell.textContent = weekdayFmt.format(d).slice(0, 3).toUpperCase();
        weekdaysEl.appendChild(cell);
      }
    })();

    const today = new Date();
    const maxMonthDate = new Date(today.getFullYear(), today.getMonth() + 2, 1);

    function canGoPrev(): boolean {
      return viewYear > today.getFullYear() ||
        (viewYear === today.getFullYear() && viewMonth > today.getMonth());
    }

    function canGoNext(): boolean {
      return viewYear < maxMonthDate.getFullYear() ||
        (viewYear === maxMonthDate.getFullYear() && viewMonth < maxMonthDate.getMonth());
    }

    async function loadMonth(y: number, m: number): Promise<string[] | 'error'> {
      const key = monthKey(y, m);
      const cached = monthCache.get(key);
      if (cached && cached !== 'error') return cached;
      try {
        const res = await fetch(
          `${apiUrl}/api/booking/days?month=${key}&tz=${encodeURIComponent(timezone)}`,
          { headers: { Accept: 'application/json' } },
        );
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as { days?: string[] };
        const days = Array.isArray(data.days) ? data.days : [];
        monthCache.set(key, days);
        return days;
      } catch {
        monthCache.set(key, 'error');
        return 'error';
      }
    }

    async function renderMonth(): Promise<void> {
      const seq = ++fetchSeq;
      monthLabel.textContent = monthFmt.format(new Date(viewYear, viewMonth, 1));
      prevBtn.disabled = !canGoPrev();
      nextBtn.disabled = !canGoNext();
      daysEl.textContent = '';
      calStatus.hidden = false;
      calStatus.className = 'bw__cal-status bw__cal-status--loading';
      calStatus.textContent = 'Checking availability…';

      const available = await loadMonth(viewYear, viewMonth);
      if (seq !== fetchSeq) return;

      if (available === 'error') {
        calStatus.className = 'bw__cal-status bw__cal-status--error';
        calStatus.textContent = "We couldn't reach the live calendar. ";
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'bw__retry';
        retry.textContent = 'Try again';
        retry.addEventListener('click', () => {
          monthCache.delete(monthKey(viewYear, viewMonth));
          void renderMonth();
        });
        calStatus.appendChild(retry);
        return;
      }

      calStatus.hidden = true;
      const availableSet = new Set(available);
      const firstDow = new Date(viewYear, viewMonth, 1).getDay(); // 0 = Sun
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
      const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

      for (let i = 0; i < firstDow; i++) {
        daysEl.appendChild(document.createElement('span'));
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const key = `${viewYear}-${pad(viewMonth + 1)}-${pad(d)}`;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bw__day';
        btn.textContent = String(d);
        if (key === todayKey) btn.classList.add('is-today');
        if (availableSet.has(key)) {
          btn.classList.add('is-available');
          btn.setAttribute('aria-pressed', String(key === selectedDate));
          if (key === selectedDate) btn.classList.add('is-selected');
          btn.addEventListener('click', () => selectDate(key));
        } else {
          btn.disabled = true;
        }
        daysEl.appendChild(btn);
      }

      if (available.length === 0) {
        calStatus.hidden = false;
        calStatus.className = 'bw__cal-status';
        calStatus.textContent = 'No open days this month — try the next month.';
      }
    }

    function selectDate(key: string): void {
      selectedDate = key;
      selectedSlot = null;
      for (const el of daysEl.querySelectorAll<HTMLButtonElement>('.bw__day.is-available')) {
        const active = el.textContent === String(Number(key.slice(8)));
        el.classList.toggle('is-selected', active);
        el.setAttribute('aria-pressed', String(active));
      }
      timesCol.hidden = false;
      timesDay.textContent = longDayFmt.format(dateFromKey(key));
      root.classList.add('bw--times-open');
      void loadSlots(key);
    }

    // -- times --------------------------------------------------------------

    function setTimeStatus(kind: 'loading' | 'empty' | 'error' | 'info' | null, msg = ''): void {
      timesEl.textContent = '';
      if (kind === null) {
        timeStatus.hidden = true;
        timeStatus.textContent = '';
        timeStatus.className = 'bw__times-status';
        return;
      }
      timeStatus.hidden = false;
      timeStatus.className = `bw__times-status bw__times-status--${kind}`;
      timeStatus.textContent = msg;
      if (kind === 'error') {
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'bw__retry';
        retry.textContent = 'Try again';
        retry.addEventListener('click', () => {
          if (selectedDate) void loadSlots(selectedDate);
        });
        timeStatus.append(' ', retry);
      }
    }

    async function loadSlots(date: string): Promise<Slot[]> {
      const seq = ++fetchSeq;
      setTimeStatus('loading', 'Loading times…');
      try {
        const res = await fetch(
          `${apiUrl}/api/booking/slots?date=${encodeURIComponent(date)}&tz=${encodeURIComponent(timezone)}`,
          { headers: { Accept: 'application/json' } },
        );
        if (!res.ok) throw new Error(`slots request failed (${res.status})`);
        const data = (await res.json()) as { slots?: Slot[] };
        const slots = Array.isArray(data.slots) ? data.slots : [];
        if (seq !== fetchSeq) return slots;
        if (slots.length === 0) {
          setTimeStatus('empty', 'No open times this day — pick another day.');
        } else {
          setTimeStatus(null);
          renderSlots(slots);
        }
        return slots;
      } catch {
        if (seq === fetchSeq) {
          setTimeStatus('error', "We couldn't load times.");
        }
        return [];
      }
    }

    function renderSlots(slots: Slot[]): void {
      timesEl.textContent = '';
      for (const slot of slots) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bw__time';
        btn.textContent = timeFmt.format(new Date(slot.start));
        btn.addEventListener('click', () => selectSlot(slot));
        timesEl.appendChild(btn);
      }
    }

    function selectSlot(slot: Slot): void {
      selectedSlot = slot;
      chosenSlotEl.textContent = slotLabel(slot);
      pickView.hidden = true;
      formView.hidden = false;
      hideSubmitAlert();
      formView.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (!startedTracked) {
        startedTracked = true;
        track('booking_started');
      }
    }

    backBtn.addEventListener('click', () => {
      formView.hidden = true;
      pickView.hidden = false;
    });

    // -- form + submit ------------------------------------------------------

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function fieldError(name: string, show: boolean): void {
      const err = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name);
      if (err) err.hidden = !show;
      if (input instanceof HTMLElement) input.setAttribute('aria-invalid', String(show));
    }

    function showSubmitAlert(message: string, kind: 'error' | 'info' = 'error'): void {
      submitAlert.hidden = false;
      submitAlert.textContent = message;
      submitAlert.className = `bw__alert bw__alert--${kind}`;
    }

    function hideSubmitAlert(): void {
      submitAlert.hidden = true;
      submitAlert.textContent = '';
    }

    function fieldValue(name: string): string {
      const el = form.elements.namedItem(name);
      return el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement ||
        el instanceof HTMLSelectElement
        ? el.value.trim()
        : '';
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void submitBooking();
    });

    async function submitBooking(): Promise<void> {
      hideSubmitAlert();

      const name = fieldValue('name');
      const email = fieldValue('email');
      const phone = fieldValue('phone');
      const practiceType = fieldValue('practice_type');
      const patientFlow = fieldValue('patient_flow');

      const checks: Array<[string, boolean]> = [
        ['name', name.length > 0],
        ['email', EMAIL_RE.test(email)],
        ['phone', phone.length >= 5],
        ['practice_type', practiceType.length > 0],
        ['patient_flow', patientFlow.length > 0],
      ];
      let allOk = true;
      for (const [field, ok] of checks) {
        fieldError(field, !ok);
        if (!ok) allOk = false;
      }
      if (!allOk) return;

      if (!selectedSlot) {
        showSubmitAlert('Please pick a time first.');
        return;
      }
      const slot = selectedSlot;

      const payload: Record<string, string> = {
        start: slot.start,
        name,
        email,
        phone,
        practice_type: practiceType,
        patient_flow: patientFlow,
        timezone,
      };
      const notes = fieldValue('notes');
      if (notes) payload.notes = notes;

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      submitBtn.textContent = 'Scheduling…';

      try {
        const res = await fetch(`${apiUrl}/api/booking`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.status === 201) {
          track('booking_completed');
          successWhen.textContent = slotLabel(slot);
          pickView.hidden = true;
          formView.hidden = true;
          root.classList.add('bw--done');
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        if (res.status === 409) {
          selectedSlot = null;
          formView.hidden = true;
          pickView.hidden = false;
          if (selectedDate) {
            monthCache.delete(monthKey(viewYear, viewMonth));
            const fresh = await loadSlots(selectedDate);
            setTimeStatus(
              'info',
              fresh.length
                ? 'That time was just taken — sorry! Here are the latest open times.'
                : 'That time was just taken and nothing else is open that day. Please pick another day.',
            );
            if (fresh.length) renderSlots(fresh);
          }
          return;
        }

        const body = (await res.json().catch(() => null)) as { error?: string } | null;
        showSubmitAlert(
          body?.error && body.error !== 'slot_taken'
            ? `We couldn't complete the booking (${body.error}). Please check your details and try again.`
            : "We couldn't complete the booking. Please check your details and try again.",
        );
      } catch {
        showSubmitAlert(
          "We couldn't reach the booking service. Please check your connection and try again — your details are still filled in.",
        );
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    }

    // -- go -----------------------------------------------------------------

    prevBtn.addEventListener('click', () => {
      if (!canGoPrev()) return;
      viewMonth--;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear--;
      }
      void renderMonth();
    });
    nextBtn.addEventListener('click', () => {
      if (!canGoNext()) return;
      viewMonth++;
      if (viewMonth > 11) {
        viewMonth = 0;
        viewYear++;
      }
      void renderMonth();
    });

    viewYear = today.getFullYear();
    viewMonth = today.getMonth();
    void renderMonth();
  }
</script>

<style is:global>
  .bw {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    display: grid;
    grid-template-columns: 17rem 1fr;
    min-height: 30rem;
    overflow: hidden;
  }

  /* Info panel ------------------------------------------------------------ */
  .bw__info {
    border-right: 1px solid var(--border);
    padding: 2rem 1.75rem;
    background: var(--bg);
  }

  .bw__brand {
    color: var(--muted);
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 0.35rem;
  }

  .bw__event {
    font-size: 1.45rem;
    margin-bottom: 1.25rem;
  }

  .bw__meta {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .bw__meta li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .bw__meta svg {
    flex: none;
    color: var(--teal-600);
  }

  .bw__desc {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0;
  }

  /* Main area ------------------------------------------------------------- */
  .bw__main {
    padding: 2rem clamp(1.25rem, 3vw, 2.25rem);
  }

  .bw__heading {
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
  }

  .bw__pick-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .bw--times-open .bw__pick-cols {
    grid-template-columns: 1fr 13rem;
  }

  /* Calendar -------------------------------------------------------------- */
  .bw__calendar {
    max-width: 26rem;
  }

  .bw__month-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }

  .bw__month-label {
