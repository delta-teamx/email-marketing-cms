---
/**
 * Implenix logo. Trimmed brand asset from /public/media; the dark variant
 * (white wordmark + cyan mark) is used on dark surfaces like the footer.
 * Intrinsic asset size is 369×98 — rendered at 120×32 to avoid layout shift.
 */
interface Props {
  /** Renders the dark-background variant. */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;
const src = onDark ? '/media/implenix-logo-dark.png' : '/media/implenix-logo.png';
---

<img
  class="logo"
  src={src}
  alt="Implenix"
  width="120"
  height="32"
  decoding="async"
/>

<style>
  .logo {
    display: block;
    width: 120px;
    height: 32px;
    object-fit: contain;
  }
</style>
