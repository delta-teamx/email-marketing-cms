---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'How does pricing work?',
    a: 'We price as a percentage of monthly collections, so our incentives are aligned with yours: we only do well when you get paid. The exact rate depends on your specialty, claim volume, and payer mix — book a call and we will quote you after a short review of your current billing. There are no long-term lock-ins and no per-claim surprise fees.',
  },
  {
    q: 'We already have a biller. How hard is it to switch?',
    a: 'Switching is easier than most practices expect. We run a structured transition: we take over new claims first, work your existing accounts receivable in parallel, and coordinate the handoff so nothing falls through the cracks. Most practices switch without any interruption to cash flow.',
  },
  {
    q: 'Do we have to change our EHR or practice management software?',
    a: 'No. We work inside your existing EHR and practice management system — we request appropriately scoped user access and handle billing in the tools you already use. There is no data migration and no new software for your front desk to learn.',
  },
  {
    q: 'Are you HIPAA compliant?',
    a: 'Yes. As a billing company we operate as a business associate under HIPAA. We sign a Business Associate Agreement (BAA) with every client, apply the minimum-necessary standard to all PHI access, and maintain administrative, physical, and technical safeguards. See our HIPAA Notice for details.',
  },
  {
    q: 'How long does onboarding take?',
    a: 'Typically two to four weeks from signed agreement to us fully running your billing, depending on payer enrollment and system access. You will have a clear week-by-week onboarding plan from day one, and claims keep going out the door during the transition.',
  },
  {
    q: 'Which specialties do you support?',
    a: 'We support solo practitioners, group practices, and specialists across family medicine, internal medicine, mental and behavioral health, physical and occupational therapy, chiropractic, and more. If your specialty is not listed, book a call — coverage is broader than this list.',
  },
];

const professionalServiceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Implenix',
  description:
    'End-to-end medical billing services for US practitioners: claims submission, denial management, AR follow-up, eligibility verification, credentialing, and patient billing support.',
  url: 'https://implenix.net',
  email: 'contact@implenix.net',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1879 NW 8th St',
    addressLocality: 'Miami',
    addressRegion: 'FL',
    postalCode: '33125',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  knowsAbout: [
    'Medical billing',
    'Claim denial management',
    'Revenue cycle management',
    'Provider credentialing',
    'Accounts receivable follow-up',
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const services = [
  {
    title: 'Claims submission & scrubbing',
    body: 'Every claim is scrubbed against payer rules before it goes out, so errors are caught on our desk — not in a denial letter weeks later.',
  },
  {
    title: 'Denial management & appeals',
    body: 'Denials get worked, not written off. We identify the root cause, correct, appeal, and resubmit — and fix the process so the same denial stops recurring.',
  },
  {
    title: 'AR follow-up',
    body: 'Aging claims do not sit. We chase every unpaid claim through to resolution, so revenue you have already earned actually reaches your account.',
  },
  {
    title: 'Eligibility & benefits verification',
    body: 'Coverage checked before the visit, not after. Fewer eligibility denials, fewer surprise patient balances, cleaner claims from the start.',
  },
  {
    title: 'Provider credentialing',
    body: 'Enrollment and re-credentialing with payers, handled end to end — applications, CAQH upkeep, and follow-up until you are in network and billable.',
  },
  {
    title: 'Patient billing support',
    body: 'Clear statements and a professional, patient-friendly point of contact for balance questions — so your front desk stays focused on care.',
  },
];

const steps = [
  {
    title: 'Book a call',
    body: 'Pick a time that works for you. In 30 minutes we learn how your practice bills today and where revenue is leaking.',
  },
  {
    title: 'We audit your billing',
    body: 'We review your denials, AR aging, and payer mix, then hand you a concrete picture of what should change — no obligation.',
  },
  {
    title: 'We run your revenue cycle',
    body: 'We take over claims, denials, and follow-up inside your existing systems. You see the results in your deposits and your reports.',
  },
];

const audiences = [
  {
    title: 'Solo practitioners',
    body: 'You did not open a practice to fight insurance companies. We take billing entirely off your plate, at a cost that makes sense for a single-provider office.',
  },
  {
    title: 'Group practices',
    body: 'Multiple providers, multiple payer contracts, one accountable billing partner — with reporting that shows exactly how each provider is collecting.',
  },
  {
    title: 'Specialists',
    body: 'Specialty billing rules are where generic billers slip. We work daily with family medicine, mental health, PT/OT, chiropractic, and other specialty claim sets.',
  },
];
---

<Layout
  title="Implenix — Medical Billing Services for US Practitioners"
  description="Stop losing revenue to claim denials. Implenix handles claims submission, denial management, AR follow-up, credentialing, and patient billing for US practitioners — so you get paid on time."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(professionalServiceLd)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__kicker">Medical billing for US practitioners</p>
      <h1>Stop losing revenue to claim denials.</h1>
      <p class="hero__sub">
        Implenix runs your entire billing operation — claims, denials, AR
        follow-up, and credentialing — so your practice gets paid on time,
        every time, while you stay focused on patients.
      </p>
      <div class="hero__actions">
        <a href="/book" class="btn btn--primary btn--lg">Book a call</a>
        <a href="#services" class="btn btn--ghost btn--lg">See what we do</a>
      </div>
    </div>
  </section>

  <!-- Stats / trust band -->
  <section class="trust" aria-label="Our service standards">
    <div class="container trust__inner">
      <div class="trust__item">
        <span class="trust__stat">98%</span>
        <span class="trust__label">first-pass clean claim target on every submission</span>
      </div>
      <div class="trust__item">
        <span class="trust__stat">48h</span>
        <span class="trust__label">claim submission standard from receipt of encounter</span>
      </div>
      <div class="trust__item">
        <span class="trust__stat">100%</span>
        <span class="trust__label">of denials worked — follow-up on every claim, no write-off by default</span>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Services</span>
        <h2>Your whole revenue cycle, handled</h2>
        <p>
          One accountable partner from the moment a patient books to the moment
          the payment clears.
        </p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <article class="card">
            <span class="card__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">How it works</span>
        <h2>From first call to full-service billing</h2>
        <p>Three steps. No disruption to your practice along the way.</p>
      </div>
      <ol class="steps">
        {steps.map((step, i) => (
          <li class="steps__item">
            <span class="steps__num" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="steps__cta">
        <a href="/book" class="btn btn--primary">Start with a free call</a>
      </p>
    </div>
  </section>

  <!-- Who we serve -->
  <section id="who-we-serve" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Who we serve</span>
        <h2>Built for practitioners, not hospital systems</h2>
        <p>
          We specialize in independent practices — the offices that feel every
          denied claim in their monthly deposits.
        </p>
      </div>
      <div class="audience-grid">
        {audiences.map((a) => (
          <article class="card card--audience">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))}
      </div>
      <p class="audience-note">
        Supporting family medicine, internal medicine, mental &amp; behavioral
        health, physical &amp; occupational therapy, chiropractic, and more.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section section--alt">
    <div class="container faq__container">
      <div class="section-head">
        <span class="kicker">FAQ</span>
        <h2>Questions practitioners ask us</h2>
      </div>
      <div class="faq__list">
        {faqs.map(({ q, a }) => (
          <details class="faq__item">
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container final-cta__inner">
      <h2>Find out what your denials are really costing you</h2>
      <p>
        Book a free 30-minute call. We will look at how your practice bills
        today and tell you plainly what we would do differently.
      </p>
      <a href="/book" class="btn btn--light btn--lg">Book a call</a>
    </div>
  </section>
</Layout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    background:
      radial-gradient(60rem 30rem at 85% -10%, rgba(15, 163, 163, 0.14), transparent 60%),
      radial-gradient(50rem 26rem at -10% 110%, rgba(11, 33, 64, 0.08), transparent 60%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    max-width: 52rem;
    text-align: center;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .hero__kicker {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-600);
    background: var(--teal-50);
    border: 1px solid var(--teal-100);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    margin-bottom: 1.5rem;
  }

  .hero__sub {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 40rem;
    margin: 0 auto 2.25rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Trust band ------------------------------------------------------------ */
  .trust {
    background: var(--navy-900);
    color: #fff;
  }

  .trust__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-block: 2.75rem;
  }

  .trust__item {
    display: grid;
    gap: 0.35rem;
    text-align: center;
  }

  .trust__stat {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--teal-500);
  }

  .trust__label {
    color: var(--navy-100);
    font-size: 0.95rem;
    max-width: 18rem;
    margin-inline: auto;
  }

  @media (max-width: 720px) {
    .trust__inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  /* Cards / grids --------------------------------------------------------- */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .services-grid,
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .services-grid,
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .card p {
    color: var(--muted);
    margin: 0;
  }

  .card__tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    background: var(--teal-100);
    color: var(--teal-600);
    margin-bottom: 1rem;
  }

  .card--audience {
    background: var(--bg-alt);
    box-shadow: none;
  }

  .audience-note {
    text-align: center;
    color: var(--muted);
    margin: 2.25rem auto 0;
    max-width: 38rem;
  }

  /* Steps ----------------------------------------------------------------- */
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .steps__item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }

  .steps__item p {
    color: var(--muted);
    margin: 0;
  }

  .steps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--navy-800);
    color: #fff;
    font-weight: 750;
    margin-bottom: 1rem;
  }

  .steps__cta {
    text-align: center;
    margin: 2.5rem 0 0;
  }

  /* FAQ ------------------------------------------------------------------- */
  .faq__container {
    max-width: 46rem;
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0;
  }

  .faq__item summary {
    cursor: pointer;
    font-weight: 650;
    color: var(--navy-800);
    padding: 1.1rem 1.4rem;
    list-style: none;
    position: relative;
    padding-right: 3rem;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    position: absolute;
    right: 1.3rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--teal-600);
  }

  .faq__item[open] summary::after {
    content: '\2212';
  }

  .faq__item p {
    padding: 0 1.4rem 1.25rem;
    margin: 0;
    color: var(--muted);
  }

  /* Final CTA ------------------------------------------------------------- */
  .final-cta {
    background: linear-gradient(135deg, var(--navy-800), var(--navy-700));
  }

  .final-cta__inner {
    text-align: center;
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
    max-width: 42rem;
  }

  .final-cta h2 {
    color: #fff;
  }

  .final-cta p {
    color: var(--navy-100);
    font-size: 1.15rem;
    margin-bottom: 2rem;
  }
</style>
