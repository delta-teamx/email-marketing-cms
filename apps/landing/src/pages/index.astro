---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'How does pricing work?',
    a: 'We price as a percentage of monthly collections, so our incentives are aligned with yours: we only do well when you get paid. The exact rate depends on your specialty, claim volume, and payer mix — book a call and we will quote you after a short review of your current billing. There are no long-term lock-ins and no per-claim surprise fees.',
  },
  {
    q: 'We already have a biller. How hard is it to switch?',
    a: 'Switching is easier than most practices expect. We run a structured transition: we take over new claims first, work your existing accounts receivable in parallel, and coordinate the handoff so nothing falls through the cracks. Most practices switch without any interruption to cash flow.',
  },
  {
    q: 'Do we have to change our EHR or practice management software?',
    a: 'No. We work inside your existing EHR and practice management system — we request appropriately scoped user access and handle billing in the tools you already use. There is no data migration and no new software for your front desk to learn.',
  },
  {
    q: 'Does Implenix replace our front-desk or clinical staff?',
    a: 'No — we replace the billing headache, not your people. Your team keeps doing what they do today; we take over the claim work that happens behind the scenes: coding review, scrubbing, submission, denials, follow-up, and patient balance questions.',
  },
  {
    q: 'Are you HIPAA compliant?',
    a: 'Yes. As a billing company we operate as a business associate under HIPAA. We sign a Business Associate Agreement (BAA) with every client, apply the minimum-necessary standard to all PHI access, and maintain administrative, physical, and technical safeguards. See our HIPAA Notice for details.',
  },
  {
    q: 'What visibility do we get into our own billing?',
    a: 'Full visibility. You receive clear monthly reporting — charges, collections, adjustments, denial reasons, and AR aging by payer — plus a named point of contact who can answer "where is this claim?" any day of the month. Your data stays in your systems; you are never locked out of your own numbers.',
  },
  {
    q: 'How long does onboarding take?',
    a: 'Typically two to four weeks from signed agreement to us fully running your billing, depending on payer enrollment and system access. You will have a clear week-by-week onboarding plan from day one, and claims keep going out the door during the transition.',
  },
  {
    q: 'Which specialties do you support?',
    a: 'We support practices across family medicine, internal medicine, mental and behavioral health, physical and occupational therapy, chiropractic, pain management, laboratories, imaging, and many more. If your specialty is not listed, book a call — coverage is broader than any list on this page.',
  },
];

const professionalServiceLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Implenix',
  description:
    'End-to-end medical billing and revenue cycle management for US practices: eligibility verification, medical coding, claims submission, denial management, AR follow-up, credentialing, payment posting, and patient billing support.',
  url: 'https://implenix.net',
  email: 'contact@implenix.net',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1879 NW 8th St',
    addressLocality: 'Miami',
    addressRegion: 'FL',
    postalCode: '33125',
    addressCountry: 'US',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United States',
  },
  knowsAbout: [
    'Medical billing',
    'Revenue cycle management',
    'Medical coding',
    'Claim denial management',
    'Provider credentialing',
    'Accounts receivable follow-up',
    'Eligibility verification',
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const rcmSteps = [
  {
    title: 'Eligibility & benefits',
    body: 'Coverage, copays, deductibles, and authorization requirements verified before the patient is seen.',
  },
  {
    title: 'Coding review',
    body: 'CPT and ICD-10 codes checked for accuracy and payer compliance before a claim is ever created.',
  },
  {
    title: 'Scrub & submit',
    body: 'Claims scrubbed against payer rules and out the door fast — errors caught on our desk, not in denials.',
  },
  {
    title: 'Payment posting',
    body: 'ERAs and EOBs posted accurately, underpayments flagged against your contracted rates.',
  },
  {
    title: 'Denials & appeals',
    body: 'Every denial worked to root cause — corrected, appealed, resubmitted, and prevented from recurring.',
  },
  {
    title: 'AR follow-up',
    body: 'Aging claims chased to resolution on a schedule, so earned revenue does not die in a work queue.',
  },
  {
    title: 'Patient billing & reporting',
    body: 'Clear patient statements, professional balance support, and monthly reporting you can actually read.',
  },
];

const services = [
  {
    title: 'Eligibility & benefits verification',
    body: 'Coverage checked before the visit, not after. Fewer eligibility denials, fewer surprise patient balances, cleaner claims from the start.',
  },
  {
    title: 'Medical coding',
    body: 'Claims go out with accurate CPT and ICD-10 coding, reviewed against current payer guidelines — the single biggest lever on denial rates.',
  },
  {
    title: 'Claims submission & scrubbing',
    body: 'Every claim is scrubbed against payer rules before it goes out, so errors are caught on our desk — not in a denial letter weeks later.',
  },
  {
    title: 'Denial management & appeals',
    body: 'Denials get worked, not written off. We identify the root cause, correct, appeal, and resubmit — and fix the process so the same denial stops recurring.',
  },
  {
    title: 'AR follow-up',
    body: 'Aging claims do not sit. We chase every unpaid claim through to resolution, so revenue you have already earned actually reaches your account.',
  },
  {
    title: 'Provider credentialing',
    body: 'Enrollment and re-credentialing with payers, handled end to end — applications, CAQH upkeep, and follow-up until you are in network and billable.',
  },
  {
    title: 'Payment posting & reporting',
    body: 'Payments posted accurately and reconciled, with monthly reporting that shows charges, collections, denials, and AR aging in plain language.',
  },
  {
    title: 'Patient billing support',
    body: 'Clear statements and a professional, patient-friendly point of contact for balance questions — so your front desk stays focused on care.',
  },
];

const compareRows = [
  {
    label: 'Denied claims',
    typical: 'Written off when the team runs out of time',
    implenix: 'Worked to root cause, appealed, and prevented from recurring',
  },
  {
    label: 'AR over 90 days',
    typical: 'Grows quietly until it is unrecoverable',
    implenix: 'Chased on a schedule until it is paid or truly closed',
  },
  {
    label: 'Eligibility',
    typical: 'Checked sometimes, discovered in denials',
    implenix: 'Verified before every visit, including benefits and auth requirements',
  },
  {
    label: 'Visibility',
    typical: 'A spreadsheet, if you ask twice',
    implenix: 'Monthly reporting plus a named contact who answers "where is this claim?"',
  },
  {
    label: 'Cost',
    typical: 'Salaries, software, and turnover — paid whether you collect or not',
    implenix: 'A percentage of collections — we only do well when you get paid',
  },
];

const steps = [
  {
    title: 'Book a call',
    body: 'Pick a time that works for you. In 30 minutes we learn how your practice bills today and where revenue is leaking.',
  },
  {
    title: 'We audit your billing',
    body: 'We review your denials, AR aging, and payer mix, then hand you a concrete picture of what should change — no obligation.',
  },
  {
    title: 'We run your revenue cycle',
    body: 'We take over claims, denials, and follow-up inside your existing systems. You see the results in your deposits and your reports.',
  },
];

const audiences = [
  {
    title: 'Solo practitioners',
    body: 'You did not open a practice to fight insurance companies. We take billing entirely off your plate, at a cost that makes sense for a single-provider office.',
  },
  {
    title: 'Group practices',
    body: 'Multiple providers, multiple payer contracts, one accountable billing partner — with reporting that shows exactly how each provider is collecting.',
  },
  {
    title: 'Clinics & facilities',
    body: 'From therapy clinics to labs and imaging centers, we handle high-volume, specialty-specific claim sets with the payer rules they demand.',
  },
];

const specialties = [
  'Family medicine',
  'Internal medicine',
  'Mental & behavioral health',
  'Physical & occupational therapy',
  'Chiropractic',
  'Pain management',
  'Podiatry',
  'Dermatology',
  'Cardiology',
  'Urgent care',
  'Laboratories',
  'Imaging centers',
  'ENT',
  'Telehealth',
  'Rehabilitation',
  'Speech therapy',
];
---

<Layout
  title="Implenix — Medical Billing & Revenue Cycle Management"
  description="End-to-end medical billing for US practices: eligibility, coding, claims, denial management, AR follow-up, credentialing, and patient billing — priced as a percentage of collections, so we only do well when you get paid."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(professionalServiceLd)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker">Medical billing &amp; RCM for US practices</p>
        <h1>Stop losing revenue to claim denials.</h1>
        <p class="hero__sub">
          Implenix runs your entire revenue cycle — eligibility, coding, claims,
          denials, AR follow-up, and credentialing — so your practice gets paid
          on time, every time, while you stay focused on patients.
        </p>
        <div class="hero__actions">
          <a href="/book" class="btn btn--primary btn--lg">Book a call</a>
          <a href="#services" class="btn btn--ghost btn--lg">See what we do</a>
        </div>
        <ul class="hero__chips" aria-label="Key facts">
          <li>HIPAA compliant — BAA with every client</li>
          <li>Works inside your existing EHR</li>
          <li>US practices, nationwide</li>
        </ul>
      </div>
      <div class="hero__media">
        <img
          src="/media/medical-billing.avif"
          alt="Medical billing specialist reviewing patient claims and insurance paperwork at a desk"
          width="900"
          height="506"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Stats / trust band -->
  <section class="trust" aria-label="Our service standards">
    <div class="container trust__inner">
      <div class="trust__item">
        <span class="trust__stat">98%</span>
        <span class="trust__label">first-pass clean claim target on every submission</span>
      </div>
      <div class="trust__item">
        <span class="trust__stat">48h</span>
        <span class="trust__label">claim submission standard from receipt of encounter</span>
      </div>
      <div class="trust__item">
        <span class="trust__stat">100%</span>
        <span class="trust__label">of denials worked — no write-off by default</span>
      </div>
      <div class="trust__item">
        <span class="trust__stat">$0</span>
        <span class="trust__label">until you collect — we price as a percentage of collections</span>
      </div>
    </div>
  </section>

  <!-- Revenue cycle, end to end -->
  <section id="revenue-cycle" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">End to end</span>
        <h2>The entire revenue cycle, owned by one team</h2>
        <p>
          Most billing problems live in the handoffs. We remove the handoffs —
          one accountable team from the moment a patient books to the moment
          the payment clears and is reconciled.
        </p>
      </div>
      <ol class="rcm">
        {rcmSteps.map((s, i) => (
          <li class="rcm__item">
            <span class="rcm__num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Services</span>
        <h2>Everything a billing department does — without hiring one</h2>
        <p>
          Take any service on its own, or hand us the whole cycle and get one
          accountable partner.
        </p>
      </div>
      <div class="services-grid">
        {services.map((s) => (
          <article class="card">
            <span class="card__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature stories -->
  <section id="features" class="section">
    <div class="container">
      <div class="feature">
        <div class="feature__media">
          <img
            src="/media/denials.avif"
            alt="Stack of denied insurance claim forms marked for appeal and resubmission"
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="feature__copy">
          <span class="kicker">Denial management</span>
          <h2>Denials worked, not written off</h2>
          <p>
            Most billing teams quietly write off denials because appeals take
            time they don't have. We do the opposite: every denial is traced to
            its root cause, corrected, appealed, and resubmitted — then the
            process is fixed so the same denial stops happening. That is
            revenue you already earned, recovered.
          </p>
          <a href="/book" class="btn btn--primary">Get your denials reviewed</a>
        </div>
      </div>

      <div class="feature feature--reverse">
        <div class="feature__media">
          <img
            src="/media/insurance-claims.webp"
            alt="Insurance claim documents being verified and prepared for submission"
            width="612"
            height="408"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="feature__copy">
          <span class="kicker">Clean claims</span>
          <h2>Claims that get paid the first time</h2>
          <p>
            The cheapest denial is the one that never happens. Eligibility is
            verified before the visit, coding is reviewed against current payer
            guidelines, and every claim is scrubbed against payer rules before
            submission — so the overwhelming majority are paid on the first
            pass, without appeals or phone calls.
          </p>
          <a href="/book" class="btn btn--primary">See how it works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why practices switch -->
  <section id="why-switch" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why practices switch</span>
        <h2>What changes when Implenix runs your billing</h2>
      </div>
      <div class="compare" role="table" aria-label="Typical billing setup compared with Implenix">
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader" class="compare__label"></span>
          <span role="columnheader">A typical billing setup</span>
          <span role="columnheader" class="compare__implenix-head">With Implenix</span>
        </div>
        {compareRows.map((row) => (
          <div class="compare__row" role="row">
            <span class="compare__label" role="rowheader">{row.label}</span>
            <span class="compare__typical" role="cell">{row.typical}</span>
            <span class="compare__implenix" role="cell">{row.implenix}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">How it works</span>
        <h2>From first call to full-service billing</h2>
        <p>Three steps. No disruption to your practice along the way.</p>
      </div>
      <ol class="steps">
        {steps.map((step, i) => (
          <li class="steps__item">
            <span class="steps__num" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="steps__cta">
        <a href="/book" class="btn btn--primary">Start with a free call</a>
      </p>
    </div>
  </section>

  <!-- Who we serve -->
  <section id="who-we-serve" class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Who we serve</span>
        <h2>Built for practices of every size</h2>
        <p>
          From a single provider to multi-location groups and facilities — if
          denied claims show up in your deposits, we can fix them.
        </p>
      </div>
      <div class="audience-grid">
        {audiences.map((a) => (
          <article class="card card--audience">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))}
      </div>
      <div class="specialties">
        <h3 class="specialties__title">Specialties we work with daily</h3>
        <ul class="specialties__list" aria-label="Specialties">
          {specialties.map((s) => (
            <li class="specialties__chip">{s}</li>
          ))}
          <li class="specialties__chip specialties__chip--more">
            <a href="/book">+ yours — ask us</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="container faq__container">
      <div class="section-head">
        <span class="kicker">FAQ</span>
        <h2>Questions practitioners ask us</h2>
      </div>
      <div class="faq__list">
        {faqs.map(({ q, a }) => (
          <details class="faq__item">
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="container final-cta__inner">
      <h2>Find out what your denials are really costing you</h2>
      <p>
        Book a free 30-minute call. We will look at how your practice bills
        today and tell you plainly what we would do differently — no
        obligation, no pressure.
      </p>
      <a href="/book" class="btn btn--light btn--lg">Book a call</a>
    </div>
  </section>
</Layout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    background:
      radial-gradient(60rem 30rem at 85% -10%, rgba(15, 163, 163, 0.14), transparent 60%),
      radial-gradient(50rem 26rem at -10% 110%, rgba(11, 33, 64, 0.08), transparent 60%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero__media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
  }

  @media (max-width: 880px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__media {
      order: -1;
      max-width: 34rem;
      margin-inline: auto;
    }

    .hero__actions,
    .hero__chips {
      justify-content: center;
    }
  }

  .hero__kicker {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-600);
    background: var(--teal-50);
    border: 1px solid var(--teal-100);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    margin-bottom: 1.5rem;
  }

  .hero__sub {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 40rem;
    margin: 0 0 2.25rem;
  }

  @media (max-width: 880px) {
    .hero__sub {
      margin-inline: auto;
    }
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__chips {
    list-style: none;
    display: flex;
    gap: 0.6rem 1.75rem;
    flex-wrap: wrap;
    margin: 2.25rem 0 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .hero__chips li {
    position: relative;
    padding-left: 1.35rem;
  }

  .hero__chips li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--teal-100);
    border: 2px solid var(--teal-500);
  }

  /* Trust band ------------------------------------------------------------ */
  .trust {
    background: var(--navy-900);
    color: #fff;
  }

  .trust__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-block: 2.75rem;
  }

  .trust__item {
    display: grid;
    gap: 0.35rem;
    text-align: center;
  }

  .trust__stat {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--cyan);
  }

  .trust__label {
    color: var(--navy-100);
    font-size: 0.95rem;
    max-width: 18rem;
    margin-inline: auto;
  }

  @media (max-width: 900px) {
    .trust__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .trust__inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  /* RCM flow --------------------------------------------------------------- */
  .rcm {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    counter-reset: rcm;
  }

  @media (max-width: 1020px) {
    .rcm {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .rcm {
      grid-template-columns: 1fr;
    }
  }

  .rcm__item {
    position: relative;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .rcm__item h3 {
    font-size: 1.02rem;
    margin-bottom: 0.4rem;
  }

  .rcm__item p {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .rcm__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--teal-100);
    color: var(--teal-600);
    font-weight: 750;
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
  }

  /* Feature stories --------------------------------------------------------- */
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .feature + .feature {
    margin-top: clamp(3rem, 7vw, 5.5rem);
  }

  .feature--reverse .feature__media {
    order: 2;
  }

  .feature__media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  .feature__copy h2 {
    margin-bottom: 1rem;
  }

  .feature__copy p {
    color: var(--muted);
    margin-bottom: 1.75rem;
  }

  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature--reverse .feature__media {
      order: 0;
    }
  }

  /* Compare table ----------------------------------------------------------- */
  .compare {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg);
    max-width: 60rem;
    margin-inline: auto;
  }

  .compare__row {
    display: grid;
    grid-template-columns: 9.5rem 1fr 1.15fr;
    border-top: 1px solid var(--border);
  }

  .compare__row--head {
    border-top: none;
    background: var(--bg-alt);
    font-weight: 700;
    color: var(--navy-800);
  }

  .compare__row > span {
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
  }

  .compare__label {
