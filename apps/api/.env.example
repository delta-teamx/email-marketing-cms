# --- Server ---
PORT=8080
# Public base URL of this API (Render URL or api.implenix.net) — used in unsubscribe/cancel links
API_PUBLIC_URL=http://localhost:8080
# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,https://implenix.net,https://marketing.implenix.net

# --- Supabase ---
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Redis (Render Key Value) ---
REDIS_URL=redis://localhost:6379

# --- Resend ---
RESEND_API_KEY=re_...
# Svix signing secret from the Resend webhook endpoint config
RESEND_WEBHOOK_SECRET=whsec_...

# --- Anthropic (reply classification agent) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Calendar (personal Gmail via OAuth refresh token) ---
# Create an OAuth client (Desktop) in Google Cloud Console, run scripts/google-auth.mjs
# once to obtain the refresh token for the calendar owner account.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//...
GOOGLE_CALENDAR_ID=primary

# --- Booking rules (times in the owner's timezone) ---
BOOKING_TIMEZONE=America/New_York
BOOKING_DAY_START=9
BOOKING_DAY_END=17
BOOKING_SLOT_MINUTES=30
BOOKING_BUFFER_MINUTES=15
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_DAYS=1,2,3,4,5
# Identity for booking confirmations/reminders (must be a verified Resend domain)
BOOKING_FROM=Implenix <hello@e.implenix.net>

# --- Misc ---
UNSUBSCRIBE_SECRET=change-me-long-random-string
LANDING_URL=https://implenix.net
